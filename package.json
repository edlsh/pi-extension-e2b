{
	"name": "pi-extension-e2b",
	"version": "2.0.0",
	"description": "E2B cloud sandbox integration for pi — redirects all tool execution to a remote E2B sandbox",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"e2b",
		"sandbox",
		"cloud"
	],
	"license": "MIT",
	"author": "edlsh",
	"repository": {
		"type": "git",
		"url": "https://github.com/edlsh/pi-extension-e2b"
	},
	"files": [
		"index.ts",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "echo 'nothing to clean'",
		"build": "echo 'nothing to build'",
		"check": "tsc --noEmit"
	},
	"pi": {
		"extensions": ["./index.ts"]
	},
	"dependencies": {
		"e2b": "^2.31.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.80.0",
		"@types/node": "^20.19.0",
		"typebox": "^1.1.38",
		"typescript": "^5.8.3"
	}
}
